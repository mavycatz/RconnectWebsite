Options -Indexes
ServerSignature Off

# Hide Apache & PHP version info
Header always unset X-Powered-By
Header always unset Server

# Block sensitive files
<FilesMatch "\.(env|ini|log|sql|bak|zip|yml|yaml|json|lock)$">
    Require all denied
</FilesMatch>

# Block access to hidden files (.git, .htaccess backups, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Prevent direct access to app, storage, vendor (if inside public_html)
RewriteEngine On
RewriteRule ^(app|storage|vendor)/ - [F,L]

# Disable access to composer files
<FilesMatch "composer\.(json|lock)">
    Require all denied
</FilesMatch>

# Disable access to PHP files in uploads folder (if exists)
RewriteRule ^uploads/.*\.php$ - [F,L]

# Security headers
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-XSS-Protection "1; mode=block"