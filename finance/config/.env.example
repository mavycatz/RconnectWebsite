# Finance Module - Required API Keys
# Copy this file to .env and fill in your actual keys.
# DO NOT commit .env to version control.

# OpenAI
FINANCE_OPENAI_KEY=sk-your-openai-key-here

# Groq
FINANCE_GROQ_KEY=gsk-your-groq-key-here

# CSRF Secret (generate with: php -r "echo bin2hex(random_bytes(32));")
FINANCE_CSRF_SECRET=
