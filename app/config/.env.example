# PayMongo configuration (copy this file to .env and fill in your keys).
# DO NOT commit .env - it holds secret keys. Test (sk_test_/pk_test_/whsk_test_)
# and Live (sk_live_/pk_live_/whsk_live_) credentials are kept separate.
#
# Active mode: 'test' or 'live'. Any value other than 'live' is treated as 'test'.
PAYMONGO_MODE=test

# Public HTTPS base URL of the app (used for the checkout return_url).
PAYMONGO_BASE_URL=https://rconnecttms.online

# Public HTTPS URL PayMongo calls for webhook events.
PAYMONGO_WEBHOOK_URL=https://rconnecttms.online/passenger/webhooks/paymongo.php

# Test-mode credentials (PayMongo Dashboard -> Developer Tools -> API Keys / Webhooks).
PAYMONGO_TEST_PUBLIC_KEY=
PAYMONGO_TEST_SECRET_KEY=
PAYMONGO_TEST_WEBHOOK_SECRET=

# Live-mode credentials. Never commit real values.
PAYMONGO_LIVE_PUBLIC_KEY=
PAYMONGO_LIVE_SECRET_KEY=
PAYMONGO_LIVE_WEBHOOK_SECRET=

# Freshness window (seconds) accepted for webhook signatures. 600 = 10 minutes.
PAYMONGO_WEBHOOK_SIGNATURE_TTL=600

# QR Ph code lifetime in seconds (PayMongo accepts 60-9000). 1800 = 30 minutes.
PAYMONGO_QRPH_EXPIRY_SECONDS=60

# Optional token gating the pm_diag.php diagnostic endpoint. Empty disables it.
PAYMONGO_DIAG_TOKEN=